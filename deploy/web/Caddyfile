# Static server for the hosted read-only web demo (DEC-0021). TLS and the
# same-origin API proxy live in the backend's front-door Caddy; this only
# serves the exported files on :8080 inside the compose network.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	header -Server
	@static path /_expo/static/* /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	# expo-router's static export writes one HTML file per route; anything
	# else falls back to the root document so client routing still works.
	try_files {path} {path}.html {path}/index.html /index.html
	file_server
}
