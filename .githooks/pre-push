#!/usr/bin/env bash
# Refuse direct pushes to main. Every change reaches main through a pull
# request from a feature branch (DEC-0019); GitHub enforces the same rule
# server-side, this only fails faster and locally.
set -euo pipefail
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "pre-push: direct pushes to main are not allowed; push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
