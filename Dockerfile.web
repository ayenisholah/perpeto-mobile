# The hosted read-only web demo (DEC-0021). `npm run build:web` produces dist/
# first (see .github/workflows/WEB_DEMO.yml); this image only serves it.
FROM caddy:2.10.2-alpine
# The upstream binary carries cap_net_bind_service for ports below 1024. This
# server listens on 8080 and runs with every capability dropped, and the
# kernel refuses to exec a file capability it cannot grant, so remove it.
RUN setcap -r /usr/bin/caddy
COPY deploy/web/Caddyfile /etc/caddy/Caddyfile
COPY dist /srv
EXPOSE 8080
